{
  // Orbital Archive No. 01 — Markdown lint baseline.
  "config": {
    "default": true,
    "MD013": false, // line length — prose and tables run long by design
    "MD033": false, // inline HTML — README uses centered <p>/<img> banners
    "MD041": false, // first line need not be an H1 (README opens with a banner)
    "MD024": { "siblings_only": true }, // repeated headings ok across sections
    "MD026": false, // taglines are intentional headings with terminal punctuation
    "MD029": false, // ordered lists interleaved with code blocks keep their numbers
    "MD036": false // bold lead-ins are used as intentional inline emphasis
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "_qa", "CHANGELOG.md"]
}
