{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Orbital Archive No. 01 — Lunar Signal Modernism DTCG tokens. This file is the source of truth for every platform.",
  "color": {
    "$type": "color",
    "palette": {
      "orbit": { "$value": "#11181E", "$description": "Deep Orbit — deepest editorial surface" },
      "graphite": { "$value": "#253139", "$description": "Calm Graphite — default operational background" },
      "slate": { "$value": "#2D3A42", "$description": "Lunar Slate — raised surface" },
      "alloy": { "$value": "#37464F", "$description": "Elevated Alloy — controls and popovers" },
      "gridline": { "$value": "#56656E", "$description": "Grid Line — borders and schematics" },
      "dust": { "$value": "#B3BBC2", "$description": "Lunar Dust — muted content" },
      "bone": { "$value": "#E7E1D5", "$description": "Archive Bone — primary content" },
      "teal": { "$value": "#5CA3A6", "$description": "Signal Teal — active, focus, and linked state. Narrow role: never a primary or default action color." },
      "relay": { "$value": "{color.palette.teal}", "$description": "Deprecated compatibility alias for Signal Teal. Use color.palette.teal; remove this alias in v2." },
      "gold": { "$value": "#CBAE67", "$description": "Mission Gold — priority and editorial hierarchy" },
      "orange": { "$value": "#E66A2C", "$description": "Ignition Orange — primary action and editorial signal. The dominant brand hue; ration it to one job per surface, not a flood." },
      "signal": { "$value": "#7EB79E", "$description": "Signal Green — nominal and success state" },
      "rust": { "$value": "#C97A60", "$description": "Alert Rust — warning and degraded state" },
      "fault": { "$value": "#EA7468", "$description": "Fault Red — error, critical, and destructive state" }
    },
    "semantic": {
      "background": { "$value": "{color.palette.graphite}" },
      "foreground": { "$value": "{color.palette.bone}" },
      "surface": { "$value": "{color.palette.slate}" },
      "surfaceElevated": { "$value": "{color.palette.alloy}" },
      "surfaceDeep": { "$value": "{color.palette.orbit}" },
      "card": { "$value": "{color.palette.slate}" },
      "cardForeground": { "$value": "{color.palette.bone}" },
      "popover": { "$value": "{color.palette.alloy}" },
      "popoverForeground": { "$value": "{color.palette.bone}" },
      "primary": { "$value": "{color.palette.orange}" },
      "primaryForeground": { "$value": "{color.palette.orbit}" },
      "secondary": { "$value": "{color.palette.alloy}" },
      "secondaryForeground": { "$value": "{color.palette.bone}" },
      "muted": { "$value": "{color.palette.slate}" },
      "mutedForeground": { "$value": "{color.palette.dust}" },
      "accent": { "$value": "{color.palette.gold}" },
      "accentForeground": { "$value": "{color.palette.orbit}" },
      "editorialSignal": { "$value": "{color.palette.orange}" },
      "editorialSignalForeground": { "$value": "{color.palette.orbit}" },
      "info": { "$value": "{color.palette.teal}" },
      "infoForeground": { "$value": "{color.palette.orbit}" },
      "success": { "$value": "{color.palette.signal}" },
      "successForeground": { "$value": "{color.palette.orbit}" },
      "warning": { "$value": "{color.palette.rust}" },
      "warningForeground": { "$value": "{color.palette.orbit}" },
      "error": { "$value": "{color.palette.fault}" },
      "errorForeground": { "$value": "{color.palette.orbit}" },
      "destructive": { "$value": "{color.palette.fault}" },
      "destructiveForeground": { "$value": "{color.palette.orbit}" },
      "border": { "$value": "{color.palette.gridline}" },
      "input": { "$value": "{color.palette.alloy}" },
      "ring": { "$value": "{color.palette.teal}" },
      "focus": { "$value": "{color.palette.teal}" },
      "disabled": { "$value": "{color.palette.dust}" },
      "link": { "$value": "{color.palette.teal}" }
    },
    "mode": {
      "editorial": {
        "background": { "$value": "{color.palette.orbit}" },
        "surface": { "$value": "{color.palette.graphite}" },
        "surfaceElevated": { "$value": "{color.palette.slate}" },
        "border": { "$value": "{color.palette.slate}" }
      },
      "operational": {
        "background": { "$value": "{color.palette.graphite}" },
        "surface": { "$value": "{color.palette.slate}" },
        "surfaceElevated": { "$value": "{color.palette.alloy}" },
        "border": { "$value": "{color.palette.gridline}" }
      }
    },
    "data": {
      "1": { "$value": "{color.palette.orange}" },
      "2": { "$value": "{color.palette.teal}" },
      "3": { "$value": "{color.palette.gold}" },
      "4": { "$value": "{color.palette.signal}" },
      "5": { "$value": "{color.palette.dust}" },
      "6": { "$value": "{color.palette.rust}" },
      "7": { "$value": "{color.palette.fault}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif"], "$description": "Condensed neo-grotesque for editorial display" },
    "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Neutral interface grotesque" },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Telemetry and machine state" }
  },
  "fontSize": {
    "$type": "dimension",
    "display2": { "$value": "96px" },
    "display1": { "$value": "72px" },
    "h1": { "$value": "48px" },
    "h2": { "$value": "32px" },
    "h3": { "$value": "24px" },
    "h4": { "$value": "18px" },
    "bodyLg": { "$value": "17px" },
    "body": { "$value": "15px" },
    "bodySm": { "$value": "13px" },
    "label": { "$value": "12px" },
    "micro": { "$value": "11px" }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 0.92 },
    "heading": { "$value": 1.08 },
    "compact": { "$value": 1.25 },
    "body": { "$value": 1.55 },
    "relaxed": { "$value": 1.7 }
  },
  "fontWeight": {
    "$type": "number",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.08em" },
    "eyebrow": { "$value": "0.18em" },
    "signal": { "$value": "0.28em" }
  },
  "space": {
    "$type": "dimension",
    "$description": "4-point base-unit spacing scale",
    "0": { "$value": "0px" },
    "0_5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },
  "size": {
    "control": {
      "$type": "dimension",
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "48px" },
      "touch": { "$value": "44px", "$description": "Preferred interactive-icon target" }
    },
    "icon": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" },
      "xl": { "$value": "32px" },
      "display": { "$value": "48px" }
    },
    "content": {
      "$type": "dimension",
      "xs": { "$value": "320px" },
      "sm": { "$value": "480px" },
      "md": { "$value": "720px" },
      "lg": { "$value": "960px" },
      "xl": { "$value": "1280px" },
      "max": { "$value": "1440px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "2px" },
    "md": { "$value": "3px" },
    "lg": { "$value": "4px" },
    "xl": { "$value": "6px" },
    "round": { "$value": "999px" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "strong": { "$value": "2px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "none": { "$value": "none" },
    "raised": { "$value": "0 8px 24px rgb(17 24 30 / 0.24)" },
    "overlay": { "$value": "0 24px 64px rgb(17 24 30 / 0.44)" },
    "focus": { "$value": "0 0 0 3px rgb(92 163 166 / 0.28)" }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.42 },
    "muted": { "$value": 0.68 },
    "scrim": { "$value": 0.72 },
    "grid": { "$value": 0.14 },
    "hover": { "$value": 0.86 }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "0ms" },
    "fast": { "$value": "120ms" },
    "normal": { "$value": "180ms" },
    "slow": { "$value": "320ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "enter": { "$value": "cubic-bezier(0, 0, 0, 1)" },
    "exit": { "$value": "cubic-bezier(0.3, 0, 1, 1)" }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "dropdown": { "$value": 100 },
    "sticky": { "$value": 200 },
    "overlay": { "$value": 400 },
    "toast": { "$value": 500 },
    "tooltip": { "$value": 600 }
  },
  "grid": {
    "columns": { "$type": "number", "$value": 12 },
    "baseUnit": { "$type": "dimension", "$value": "4px" },
    "gutter": { "$type": "dimension", "$value": "16px" },
    "outerMargin": { "$type": "dimension", "$value": "48px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
